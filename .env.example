# HFAIO environment variables.
# Copy to .env (git-ignored) and fill in real values:   cp .env.example .env
# Never commit .env or paste real tokens into any tracked file. CI runs gitleaks.

# ---------------------------------------------------------------- backend
# Log level for the FastAPI service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Hugging Face access token (write scope) used to push fine-tuned models and
# call the Inference API for suggestions. Leave empty to skip Hub uploads.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Target Hub repo for fine-tuned checkpoints, e.g. your-user/hfaio-distilbert-sst2
HF_REPO=
# Instruction-tuned model used by POST /suggestions (falls back to rules if unreachable).
SUGGEST_MODEL=meta-llama/Llama-3.2-3B-Instruct
# SST-2 subset sizes. Small values keep CPU-only training runs short.
MAX_TRAIN=2000
MAX_EVAL=500

# --------------------------------------------------------------- postgres
# Used by the backend (DATABASE_URL) and by MLflow as its backend store.
POSTGRES_USER=hfaio
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=hfaio

# ---------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ------------------------------------------------------------------ slack
# Incoming-webhook URL for alert notifications (Slack app > Incoming Webhooks).
# Leave empty locally if you do not want Slack messages; alerts still show in
# Alertmanager at http://localhost:9093.
SLACK_WEBHOOK_URL=

# ------------------------------------------------- host ports (127.0.0.1 only)
BACKEND_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
