# HFAIO environment variables.
# Copy to .env (git-ignored) and fill in real values:   cp .env.example .env
# Never commit .env or paste real tokens into any tracked file. CI runs gitleaks.

# ---------------------------------------------------------------- backend
# Log level for the FastAPI service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Hugging Face access token (write scope) used to push fine-tuned models and
# call the Inference API for suggestions. Leave empty to skip Hub uploads.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
# Target Hub repo for fine-tuned checkpoints, e.g. your-user/hfaio-distilbert-sst2
HF_REPO=
# Instruction-tuned models used by the LLM insights endpoints (/insights/...),
# comma separated. All are queried and their answers shown side by side; the
# rule-based analysis is used if none respond. Llama models are gated: accept
# the license on the model page with the same account as HF_TOKEN.
INSIGHT_MODELS=mistralai/Mistral-7B-Instruct-v0.3,meta-llama/Llama-3.1-8B-Instruct
# Training/eval subset sizes. Small values keep CPU-only training runs short.
MAX_TRAIN=4000
MAX_EVAL=500

# ------------------------------------------------------- API protection
# When set, every POST (training, tuning, uploads, insights) needs the header
# X-API-Key: <value>. Leave empty for local development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HFAIO_API_KEY=
# Max jobs/studies queued or running at once.
MAX_ACTIVE_JOBS=3
# Per-IP rate limits, "<count>/<seconds>". Heavy = training, tuning, insights.
RATE_LIMIT_HEAVY=10/600
RATE_LIMIT_DEFAULT=60/60

# --------------------------------------------------------------- postgres
# Used by the backend (DATABASE_URL) and by MLflow as its backend store.
POSTGRES_USER=hfaio
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=hfaio

# ---------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ------------------------------------------------------------------ slack
# Incoming-webhook URL for alert notifications (Slack app > Incoming Webhooks).
# Leave empty locally if you do not want Slack messages; alerts still show in
# Alertmanager at http://localhost:9093.
SLACK_WEBHOOK_URL=

# ------------------------------------------------- host ports (127.0.0.1 only)
BACKEND_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
